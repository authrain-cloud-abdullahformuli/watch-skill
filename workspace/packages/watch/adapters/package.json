{
  "name": "@deepwatch/dsh-adapters",
  "version": "0.1.4",
  "description": "Optional adapters: Obsidian vaults and LLMWiki bundles. Watch works fully without either.",
  "type": "module",
  "license": "MIT",
  "author": "Abdullah Formuli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authrain-cloud-abdullahformuli/watch-skill.git",
    "directory": "workspace/packages/watch/adapters"
  },
  "homepage": "https://github.com/authrain-cloud-abdullahformuli/watch-skill/tree/main/workspace#readme",
  "bugs": {
    "url": "https://github.com/authrain-cloud-abdullahformuli/watch-skill/issues"
  },
  "keywords": [
    "deepwatch",
    "deepseek-harness",
    "watch-skill",
    "ai-agent",
    "agent-workspace",
    "adapters",
    "obsidian",
    "llmwiki",
    "integrations"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepwatch/dsh-memory": "workspace:^",
    "@deepwatch/dsh-wiki": "workspace:^"
  }
}
